  {"id": "W03", "category": "weights", "dataset": "annexb_minimal",
   "request": "Allocate the orders", "weights": {"cost": 1, "carbon": 0},
   "expect": {"answer_type": "allocation", "valid": true, "late_orders": 0,
              "plant": {"M1": "A", "M2": "A", "M3": "A"}},
