  {"id": "W04", "category": "weights", "dataset": "annexb_minimal",
   "request": "Allocate the orders", "weights": {"cost": 0, "carbon": 1},
   "expect": {"answer_type": "allocation", "valid": true,
              "plant": {"M1": "B", "M2": "B", "M3": "B"}},
   "why": "B is greener and has room."},
  {"id": "W05", "category": "weights", "dataset": "pack", "type": "weights_sweep",
   "request": "Allocate all orders", "scenario": {"apply_loaded_events": false},
   "sweep": [{"cost": 1, "carbon": 0}, {"cost": 0.8, "carbon": 0.2}, {"cost": 0, "carbon": 1}],
   "expect": {"monotonic": true, "distinct_plans": true},
   "why": "Three weight settings give three different plans: cost rises as carbon falls."},

