# Copy to .env and fill in. Never commit .env.

# LLM: gemini is the configured provider (langchain-google-genai is in requirements.txt)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
GEMINI_API_KEY=

# true = no LLM calls: rule-based intent parsing and template text (tests, offline demo)
MOCK_LLM=false
# hybrid = rules first, LLM only when rules don't understand; rules; llm
INTENT_MODE=hybrid

# Storage (inside Docker this is /app/state/app.db on a named volume)
DB_PATH=data/app.db
# PLANNING_START=2026-10-12   # override the planning start date

# Security: set API_KEY to require an X-API-Key header on all endpoints except /health
API_KEY=
RATE_LIMIT_PER_MIN=120
MAX_UPLOAD_MB=5

# UI -> API
API_URL=http://localhost:8000
