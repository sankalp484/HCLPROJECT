   "why": "Those 5 orders are late from every plant (transit too long)."},
  {"id": "I02", "category": "infeasible", "dataset": "pack",
   "request": "What does a 10% carbon cut cost?", "scenario": {"apply_loaded_events": false},
   "expect": {"answer_type": "infeasible"},
   "why": "The low-carbon plant C has only ~400 units/week, so a 10% cut is out of reach."},
  {"id": "I03", "category": "infeasible", "dataset": "tiny",
   "request": "Give me the cheapest plan with every order on time",
   "expect": {"answer_type": "infeasible", "infeasible_orders": ["O4"]},
   "why": "Hand-solved: O4 has 20 transit days and is late from its only plant."},

  {"id": "R01", "category": "capacity_loss", "dataset": "pack",
   "request": "Re-plan for E001",
