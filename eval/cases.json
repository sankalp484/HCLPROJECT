[
  {"id": "A01", "category": "allocation", "dataset": "pack",
   "request": "Allocate all orders for the planning horizon.",
   "scenario": {"apply_loaded_events": false},
   "expect": {"answer_type": "allocation", "valid": true, "late_orders": 5},
   "why": "Data card: exactly 5 orders have no on-time option; capacity allows the rest."},
  {"id": "A02", "category": "allocation", "dataset": "pack",
   "request": "Allocate this week's orders.",
   "scenario": {"apply_loaded_events": false},
   "expect": {"answer_type": "allocation", "valid": true, "late_orders": 0},
   "why": "None of the 5 impossible orders is in the first production week."},

  {"id": "C01", "category": "cheapest_late", "dataset": "pack",
   "request": "Why was order 7 built in Plant B?",
