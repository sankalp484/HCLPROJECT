   "why": "Data card trap: Plant A is cheapest for ORD-007 but 14 days late."},
  {"id": "C02", "category": "cheapest_late", "dataset": "pack",
   "request": "Explain order 1", "scenario": {"apply_loaded_events": false},
   "expect": {"answer_type": "allocation", "on_time": ["ORD-001"], "not_plant": {"ORD-001": "A"}},
   "why": "Cheapest plant (A) is late for ORD-001; an on-time plant exists."},
  {"id": "C03", "category": "cheapest_late", "dataset": "pack",
   "request": "Why is order 9 where it is?", "scenario": {"apply_loaded_events": false},
   "expect": {"answer_type": "allocation", "on_time": ["ORD-009"]},
   "why": "Cheapest plant is late for ORD-009; an on-time plant exists."},
  {"id": "C04", "category": "cheapest_late", "dataset": "tiny",
   "request": "Allocate the orders", "weights": {"cost": 1, "carbon": 0},
   "expect": {"answer_type": "allocation", "plant": {"O1": "B"}, "on_time": ["O1", "O2"]},
   "why": "Hand-solved: the cheapest plant (A) cannot fit O1 and O2 in time; O1 goes to B."},

  {"id": "I01", "category": "infeasible", "dataset": "pack",
   "request": "What is the cheapest plan that is on time?",
   "scenario": {"apply_loaded_events": false},
